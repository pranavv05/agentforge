{
  "name": "agentforge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Agentic spec-driven development platform with server-enforced governance, evidence-checked specs and compliance traceability.",
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @agentforge/web",
    "build": "npm run build --workspace @agentforge/web",
    "typecheck": "tsc -p tsconfig.json --noEmit && npm run typecheck --workspace @agentforge/web",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "db:migrate": "tsx packages/db/src/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset": "tsx packages/db/src/reset.ts",
    "ci": "npm run typecheck && npm run lint && npm run format:check && npm run test:cov"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^9.39.5",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "esbuild@0.28.2": true
  },
  "overrides": {
    "postcss": "^8.5.32",
    "minimatch": "^11.0.3",
    "glob": "^11.0.3"
  }
}
