{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["DOM", "DOM.Iterable", "ES2023"],
    "jsx": "preserve",
    "types": ["node", "react"],
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./*"],
      "@agentforge/contract": ["../../packages/contract/src/index.ts"],
      "@agentforge/db": ["../../packages/db/src/index.ts"],
      "@agentforge/orchestrator": ["../../packages/orchestrator/src/index.ts"],
      "@agentforge/agents": ["../../packages/agents/src/index.ts"]
    },
    "incremental": true
  },
  "include": ["**/*.ts", "**/*.tsx", ".next/types/**/*.ts", "next-env.d.ts"],
  "exclude": ["node_modules"]
}
