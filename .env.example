# Anthropic API — required for agent runs. Never commit the real value.
ANTHROPIC_API_KEY=sk-ant-...

# SQLite database file. Relative paths resolve from the repo root.
SDD_DB_PATH=./data/agentforge.db

# Hard ceiling on spend for a single spec run. The orchestrator aborts with
# BudgetExceededError rather than exceeding it.
SDD_RUN_COST_CAP_USD=2.00

# Model selection (config, never hardcoded). Haiku for development, Sonnet for demos.
SDD_MODEL_CONTEXT=claude-haiku-5-5
SDD_MODEL_REQUIREMENTS=claude-haiku-5-5
SDD_MODEL_DESIGN=claude-haiku-5-5
SDD_MODEL_TASKS=claude-haiku-5-5

# Agentic loop budget caps (see plan: 25 calls, <100K prompt keeps Haiku in its low price band).
SDD_MAX_TOOL_CALLS=25
SDD_MAX_PROMPT_TOKENS=100000

# LLM cassettes: "replay" in CI (offline, deterministic), "record" to capture, "off" for live.
SDD_CASSETTE_MODE=off

# Day-1 scaffolding only. Deleted on day 2 — see plan "No placeholder code ships".
SDD_STUB_AGENTS=false

# pino log level
LOG_LEVEL=info
