# Anthropic API — required for agent runs. Never commit the real value.
ANTHROPIC_API_KEY=sk-ant-...

# SQLite database file. Relative paths resolve from the repo root.
SDD_DB_PATH=./data/agentforge.db

# Hard ceiling on spend for a single spec run. The orchestrator aborts with
# BudgetExceededError rather than exceeding it.
SDD_RUN_COST_CAP_USD=2.00

# Model selection (config, never hardcoded). Haiku for development, Sonnet for demos.
SDD_MODEL_CONTEXT=claude-haiku-5-5
SDD_MODEL_REQUIREMENTS=claude-haiku-5-5
SDD_MODEL_DESIGN=claude-haiku-5-5
SDD_MODEL_TASKS=claude-haiku-5-5

# Agentic loop budget caps (see plan: 25 calls, <100K prompt keeps Haiku in its low price band).
SDD_MAX_TOOL_CALLS=25
SDD_MAX_PROMPT_TOKENS=100000

# LLM cassettes: "replay" runs offline against recorded responses, "record" captures new
# ones (needs a key), "off" goes straight to the live API.
SDD_CASSETTE_MODE=off

# Where cassettes live. Defaults to packages/llm/cassettes.
# SDD_CASSETTE_DIR=./packages/llm/cassettes

# Overrides the per-stage effort level (low|medium|high|xhigh|max). Unset uses the
# per-stage defaults: low for exploration, high for the stages a human reviews.
# SDD_EFFORT_OVERRIDE=

# pino log level
LOG_LEVEL=info

# --- Authentication ------------------------------------------------------
# Signs session cookies. Sessions are what the audit log's actor attribution
# rests on, so a weak or shared value here means forgeable approvals.
# Generate with: openssl rand -base64 32
# Required in production; outside production a fixed dev value is used.
BETTER_AUTH_SECRET=

# The origin Better Auth issues cookies for and validates callbacks against.
BETTER_AUTH_URL=http://localhost:3000
