# Incremental typecheck cache. A build artifact: it changes on every typecheck, so
# tracking it means every build produces a diff and every commit carries noise.
*.tsbuildinfo

# Recorded model responses, captured when SDD_CASSETTE_MODE=record. They are run
# artifacts keyed by a hash of the prompt, so they churn whenever a prompt changes and
# are regenerated on demand. The test suites use an injected stub rather than these,
# so a green build never depends on one being present.
packages/llm/cassettes/

# os / editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# The frontend track's own checkout. Its UI was ported into apps/web; the directory is
# kept locally for reference but is not part of this tree.
landing page/
