{
  "name": "webapp",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:frontend && npm run build:worker",
    "preview": "wrangler pages dev",
    "deploy": "npm run build && wrangler pages deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "dev:sandbox": "wrangler pages dev dist --d1=webapp-production --local --ip 0.0.0.0 --port 3000",
    "clean-port": "fuser -k 3000/tcp 2>/dev/null || true",
    "db:migrate:local": "wrangler d1 migrations apply webapp-production --local",
    "db:migrate:prod": "wrangler d1 migrations apply webapp-production",
    "db:reset": "rm -rf .wrangler/state/v3/d1 && npm run db:migrate:local",
    "typecheck": "tsc --noEmit",
    "build:frontend": "cd frontend && npm install --no-audit --no-fund && npx next build && node scripts/export-to-worker.mjs",
    "build:worker": "vite build",
    "dev:frontend": "cd frontend && npx next dev -p 3100"
  },
  "dependencies": {
    "hono": "^4.13.14",
    "marked": "^15.0.12"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261110.1",
    "@hono/vite-build": "^1.11.1",
    "@hono/vite-dev-server": "^0.26.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.4",
    "wrangler": "^4.110.0"
  }
}
